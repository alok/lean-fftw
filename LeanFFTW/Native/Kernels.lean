/-- Leaf pass, radix 2: leaf `j < n` reads `x[j + i·sstr]` and writes at `ofs[j]`. -/
unsafe def leafLoop2f (x ofs : @& FloatArray) (sstr n j : USize) (y : FloatArray) : FloatArray :=
  if j < n then
    leafLoop2f x ofs sstr n (j + 1) (bfly2nf x y j sstr (rd ofs j).toUSize 1)
  else y

/-- Butterflies `q < ns` of one block of an in-place pass, radix 2, at `c + q`. -/
unsafe def ditCol2f (tw : @& FloatArray) (ns c q : USize) (y : FloatArray) : FloatArray :=
  if q < ns then ditCol2f tw ns c (q + 1) (bfly2tf tw y (c + q) ns q) else y

